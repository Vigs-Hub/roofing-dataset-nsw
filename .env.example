# Copy to .env and fill. Never commit secrets.
# Spend caps: ask Neal if still MISSING.

# ABN Lookup (free) — request GUID at https://abr.business.gov.au/Tools/WebServices
ABN_GUID=

# DataForSEO (Neal-approved group account) — https://app.dataforseo.com/
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_SPEND_CAP_USD=

# Google Places (official API only) — backup to DataForSEO
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_SPEND_CAP_USD=

# Optional: Google Sheets service account JSON path (for pushing tabs)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEET_ID=
